general {
  color_bad = "#db504a"
  color_degraded = "#e3b505"
  color_good = "#dee9ee"
  colors = true
  interval = 1
}

order += "volume master"
order += "battery all"
order += "load"
order += "tztime local"
battery all {
  format = "%status %percentage %remaining"
  last_full_capacity = true
}

load {
  format = "%1min"
}

tztime local {
  format = "%m-%d-%Y %H:%M:%S"
}

volume master {
  device = "default"
  format = "♪: %volume"
  format_muted = "♪: muted (%volume)"
}
